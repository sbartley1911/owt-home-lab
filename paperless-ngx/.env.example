# Set these as Portainer "Environment variables" when deploying the stack.
# See README.md for details. *.env is gitignored; only this example is committed.

# Required (deploy fails if unset)
DB_PASSWORD=replace-me
PAPERLESS_SECRET_KEY=replace-me
PAPERLESS_ADMIN_PASSWORD=replace-me
# Broker password; URL-safe (it is embedded in PAPERLESS_REDIS), e.g. openssl rand -hex 24
REDIS_PASSWORD=replace-me

# Initial superuser (created on first start only)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_MAIL=admin@example.com

# Database: hostname of your Postgres service
PAPERLESS_DBHOST=postgres.example.internal
PAPERLESS_DBPORT=5432

# Networking
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_BIND_IP=127.0.0.1
PAPERLESS_PORT=8000

# Image versions
PAPERLESS_VERSION=3.4.2
REDIS_VERSION=8
TIKA_VERSION=3.3.1.0

# NFS bulk storage paths
CONSUME_PATH=/mnt/nfs/appdata/paperless-ngx/consume
MEDIA_PATH=/mnt/nfs/appdata/paperless-ngx/media
EXPORT_PATH=/mnt/nfs/appdata/paperless-ngx/export
