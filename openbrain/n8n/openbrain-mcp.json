    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List the most recent OpenBrain memory entries, newest first. Excludes superseded (retired) memories unless include_history is true. Optional integer 'count' controls how many to return (default 10). Each hit also has request_id, outcome, and telemetry. Empty/error responses contain one metadata-only row.",
        "operation": "executeQuery",
        "query": "select r.* from jsonb_to_recordset(rsi.response_items(rsi.recent(gen_random_uuid()::text,$3::text,$1::int,$2::boolean))) as r(id uuid,status text,content text,source text,source_ref text,captured_at timestamptz,request_id text,outcome text,telemetry text,error_code text,telemetry_error_code text,warning text)",
        "options": {
          "queryReplacement": "={{ [$fromAI('count','how many recent entries to return','number',10),$fromAI('include_history','include superseded entries','boolean',false),'mcp:openbrain'] }}"
        }
      },
      "id": "8de42842-3c99-48e3-92e4-ba1258bb3656",
      "name": "recent_entries",
