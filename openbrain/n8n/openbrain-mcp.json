    {
      "parameters": {
        "name": "capture_thought",
        "description": "Save a new thought/note into the user's OpenBrain memory. Returns the entry id. Pass source_ref to make retries idempotent (same source+source_ref updates instead of duplicating).",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_CAPTURE_WORKFLOW_ID",
          "mode": "id",
          "cachedResultName": "OpenBrain: capture"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "content": "={{ $fromAI('content','the exact thought text to remember','string') }}",
            "source": "={{ $fromAI('source','short source label','string','mcp') }}",
            "source_ref": "={{ $fromAI('source_ref','stable reference for idempotent retries (e.g. session id + note slug); empty string means no dedup','string','') }}",
            "entry_type": "={{ $fromAI('entry_type','kind of entry: thought, decision, finding, reference...','string','thought') }}",
            "metadata": "={{ $fromAI('metadata','optional JSON object with extra context','string','') }}"
          },
