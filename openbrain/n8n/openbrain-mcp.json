            {
              "id": "retrieval_caller",
              "displayName": "retrieval_caller",
              "type": "string",
              "required": false,
              "display": true,
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "f778a53e-c724-401e-ad8b-7ccfe600cf25",
      "name": "semantic_search",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [
        260,
        740
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Fetch ONE OpenBrain entry by its exact id. Takes a brain_entries UUID (for example one returned by semantic_search or stored by another system) and returns that entry verbatim: id, content, source, source_ref, captured_at. Use this whenever you already hold an id - it is an exact lookup, not a similarity guess. Returns an empty result if the id does not exist. Each hit also has request_id, outcome, and telemetry. Empty/error responses contain one metadata-only row.",
        "operation": "executeQuery",
        "query": "select r.* from jsonb_to_recordset(rsi.response_items(rsi.entry(gen_random_uuid()::text,$2::text,$1::text))) as r(id uuid,content text,source text,source_ref text,captured_at timestamptz,status text,superseded_by uuid,supersession_reason text,request_id text,outcome text,telemetry text,error_code text,telemetry_error_code text,warning text)",
        "options": {
          "queryReplacement": "={{ [$fromAI('id','the OpenBrain entry UUID to fetch exactly','string'),'mcp:openbrain'] }}"
        }
      },
      "id": "ab0146f6-c804-4ff1-a2df-b69706022e41",
      "name": "get_entry_by_id",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
