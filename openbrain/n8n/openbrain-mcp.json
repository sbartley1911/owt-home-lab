    {
      "parameters": {
        "name": "semantic_search",
        "description": "Search the user's OpenBrain memory by meaning; returns the most similar stored thoughts. Each hit also has request_id, outcome, and telemetry status. Empty/error responses contain one metadata-only row. Use request_id for record_retrieval_feedback; unrated does not mean not useful.",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_SEARCH_WORKFLOW_ID",
          "mode": "id",
          "cachedResultName": "OpenBrain: search"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "query": "={{ $fromAI('query','what to search for','string') }}",
            "count": "={{ $fromAI('count','max results','number',8) }}",
            "source": "={{ $fromAI('source','optional source filter','string','') }}",
            "retrieval_caller": "mcp:openbrain"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "query",
              "displayName": "query",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
