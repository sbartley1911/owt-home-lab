    },
    {
      "id": "fe8786b7-85ad-44e7-a487-f8f1bd024e1e",
      "name": "record_retrieval_feedback",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        720,
        480
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "OpenBrain DB"
        }
      },
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Record explicit usefulness for a logged retrieval from this MCP endpoint. Supply a new UUID feedback_id and reuse it only for retries of the identical submission. usefulness: useful, partly_useful, or not_useful. Endpoint identity is shared, not a verified individual. Do not infer usefulness from search scores.",
        "operation": "executeQuery",
        "query": "select rsi.record_feedback($1::uuid,$2::text,$3::text,$4::text,NULLIF($5::text,''),NULLIF($6::text,'')::uuid) as feedback",
        "options": {
          "queryReplacement": "={{ [$fromAI('feedback_id','UUID for this feedback; reuse on retry','string'),$fromAI('request_id','request_id from a logged retrieval','string'),'mcp:openbrain',$fromAI('usefulness','useful, partly_useful, or not_useful','string'),$fromAI('reason','optional explanation','string',''),$fromAI('expected_entry_id','optional expected entry UUID','string','')] }}"
        }
      }
    }
